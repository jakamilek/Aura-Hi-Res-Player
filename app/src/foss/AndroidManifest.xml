<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Privacy fork: remove capabilities unrelated to Qobuz playback. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" tools:node="remove" />

    <!-- Recognition services are not part of the Qobuz-only build. -->
    <service
        android:name="iad1tya.echo.music.widget.MusicRecognizerWidgetService"
        tools:node="remove" />
    <service
        android:name="iad1tya.echo.music.recognition.RecognitionForegroundService"
        tools:node="remove" />
    <activity
        android:name="iad1tya.echo.music.recognition.RecognitionLaunchActivity"
        tools:node="remove" />
    <service
        android:name="iad1tya.echo.music.widget.RecognitionTileService"
        tools:node="remove" />

    <!-- The removed APK updater no longer needs WorkManager's foreground service. -->
    <service
        android:name="androidx.work.impl.foreground.SystemForegroundService"
        tools:node="remove" />

    <application>
        <!-- Remove Cast provider in FOSS build since GMS is not available -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            tools:node="remove" />
    </application>
</manifest>
