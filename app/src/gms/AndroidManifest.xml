<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GMS variant keeps only permissions needed by playback, local audio and Cast. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <service android:name=".widget.MusicRecognizerWidgetService" tools:node="remove" />
    <activity android:name=".recognition.RecognitionLaunchActivity" tools:node="remove" />
    <service android:name=".recognition.RecognitionForegroundService" tools:node="remove" />
    <service android:name=".widget.RecognitionTileService" tools:node="remove" />
    <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />

    <!-- Listen Together is disabled in this privacy fork. Remove its app-link and notification receiver. -->
    <application>
        <activity android:name="iad1tya.echo.music.MainActivity" tools:node="merge">
            <intent-filter android:autoVerify="true" tools:node="remove">
                <data android:host="echomusic-listen-together.onrender.com" />
            </intent-filter>
            <intent-filter tools:node="remove">
                <data android:scheme="echomusic" android:host="listen" />
            </intent-filter>
        </activity>
        <receiver android:name="iad1tya.echo.music.listentogether.ListenTogetherActionReceiver" tools:node="remove" />
    </application>
</manifest>
